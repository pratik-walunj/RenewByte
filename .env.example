# ─────────────────────────────────────────────────────────────
# RenewByte environment variables
# Copy to `.env` for local development. Never commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Database (docker-compose.yml exposes Postgres on port 5440)
DATABASE_URL="postgresql://renewbyte:renewbyte@localhost:5440/renewbyte?schema=public"

# Public site URL — used for canonical URLs, sitemap, Open Graph and payment callbacks
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth — long random string (e.g. `openssl rand -base64 32`). Signs session + order tokens.
AUTH_SECRET=""

# First admin account (used by `npm run db:seed` and `npm run admin:create`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Store Admin"

# Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Same value as RAZORPAY_KEY_ID; the key id is safe to expose to Checkout.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Cloudinary (optional — product images can also be plain URLs or files in /public)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="renewbyte/products"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Contact / WhatsApp (fallbacks — the CMS "Site settings" values take priority)
NEXT_PUBLIC_WHATSAPP_NUMBER="919000000000"
NEXT_PUBLIC_CONTACT_PHONE="+91 90000 00000"
NEXT_PUBLIC_CONTACT_EMAIL="support@example.com"

# Analytics (leave empty to disable). CMS "Site settings" values take priority.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Transactional email (optional). Without a key, emails are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="RenewByte <orders@example.com>"

# Keystatic CMS storage: "local" (default, dev) or "github" (production on Vercel)
NEXT_PUBLIC_KEYSTATIC_STORAGE="local"
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO="your-org/renewbyte"
KEYSTATIC_GITHUB_CLIENT_ID=""
KEYSTATIC_GITHUB_CLIENT_SECRET=""
KEYSTATIC_SECRET=""
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=""

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""
