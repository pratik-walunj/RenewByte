// RenewByte data model.
//
// Responsibility split (see README → "CMS / database responsibility"):
//   • PostgreSQL (this schema) holds transactional + catalogue data: products,
//     inventory, carts, orders, payments, customers, coupons, reviews.
//   • Keystatic (content/**) holds marketing content: homepage, banners, blog,
//     FAQs, static/policy pages, testimonials, navigation, footer and SEO copy.
//
// All money values are stored as integers in paise (1 INR = 100 paise).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConditionGrade {
  A_PLUS
  A
  B
  C
}

enum StorageType {
  NVME_SSD
  SSD
  HDD
  EMMC
}

enum GpuType {
  INTEGRATED
  DEDICATED
}

enum OrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InboxStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

// ─────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  passwordHash  String
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  addresses           Address[]
  orders              Order[]
  cart                Cart?
  wishlist            WishlistItem[]
  reviews             Review[]
  couponRedemptions   CouponRedemption[]
  inventoryChanges    InventoryAdjustment[]
  orderEvents         OrderStatusEvent[]

  @@index([role])
  @@index([createdAt])
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String   @default("IN")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────

model Brand {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  description    String?
  logoUrl        String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Category {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  description    String?
  imageUrl       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]
  coupons  Coupon[]  @relation("CouponCategories")

  @@index([isActive, sortOrder])
}

model Product {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  sku                 String         @unique
  brandId             String
  categoryId          String
  shortDescription    String?
  description         String?
  /// Maximum retail price of the equivalent new/original unit, in paise.
  mrp                 Int
  /// Current selling price, in paise.
  price               Int
  /// Derived from mrp/price on every write (kept for fast "highest discount" sorting).
  discountPercent     Int            @default(0)
  conditionGrade      ConditionGrade
  warrantyMonths      Int            @default(6)
  processor           String
  processorBrand      String
  /// Normalised family used by filters, e.g. "Core i5", "Ryzen 7", "Apple M1".
  processorFamily     String
  processorGeneration String?
  ramGb               Int
  ramType             String?
  storageGb           Int
  storageType         StorageType
  displaySize         Float
  resolution          String?
  displayType         String?
  graphics            String
  gpuType             GpuType        @default(INTEGRATED)
  operatingSystem     String
  /// Battery health as a percentage of original design capacity.
  batteryHealth       Int?
  batteryBackup       String?
  weightKg            Float?
  color               String?
  keyboard            String?
  ports               String[]
  features            String[]
  highlights          String[]
  whatsIncluded       String[]
  isFeatured          Boolean        @default(false)
  isBestSeller        Boolean        @default(false)
  isDeal              Boolean        @default(false)
  dealEndsAt          DateTime?
  status              ProductStatus  @default(DRAFT)
  /// Sample catalogue data created by the seed script.
  isDemo              Boolean        @default(false)
  soldCount           Int            @default(0)
  ratingAvg           Float          @default(0)
  ratingCount         Int            @default(0)
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  brand          Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  specifications ProductSpecification[]
  inventory      Inventory?
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  coupons        Coupon[]               @relation("CouponProducts")

  @@index([status, createdAt])
  @@index([brandId])
  @@index([categoryId])
  @@index([price])
  @@index([isDeal])
  @@index([isBestSeller])
  @@index([isFeatured])
  @@index([processorFamily])
  @@index([ramGb])
  @@index([conditionGrade])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  width     Int      @default(1200)
  height    Int      @default(900)
  /// Cloudinary public_id when the asset is hosted on Cloudinary.
  publicId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductSpecification {
  id        String @id @default(cuid())
  productId String
  group     String @default("General")
  label     String
  value     String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────────────────────

/// Available = quantity − reserved. Reserved units are held by unpaid online orders.
model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  quantity          Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(3)
  updatedAt         DateTime @updatedAt

  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustments InventoryAdjustment[]
}

model InventoryAdjustment {
  id          String   @id @default(cuid())
  inventoryId String
  /// Signed change applied to `quantity` (reservations are not logged here).
  change      Int
  reason      String
  orderId     String?
  userId      String?
  createdAt   DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Cart & wishlist
// ─────────────────────────────────────────────────────────────

/// A cart belongs to a signed-in user, or to an anonymous visitor via `guestToken` (cookie).
model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  guestToken String?  @unique
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  productId      String
  quantity       Int      @default(1)
  savedForLater  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─────────────────────────────────────────────────────────────
// Orders & payments
// ─────────────────────────────────────────────────────────────

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  /// Random token that lets a guest open their confirmation page.
  accessToken     String
  userId          String?
  customerName    String
  email           String
  phone           String
  /// Snapshot of the shipping address at the time of purchase.
  shippingAddress Json
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus  @default(CREATED)
  deliveryMethod  DeliveryMethod @default(STANDARD)
  subtotal        Int
  discount        Int            @default(0)
  shippingFee     Int            @default(0)
  codFee          Int            @default(0)
  /// GST component (already included in totals when prices are tax-inclusive).
  tax             Int            @default(0)
  total           Int
  currency        String         @default("INR")
  couponCode      String?
  couponId        String?
  notes           String?
  courier         String?
  trackingNumber  String?
  /// True while units are held in Inventory.reserved; false once committed or released.
  stockReserved   Boolean        @default(false)
  placedAt        DateTime       @default(now())
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon     Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  payments   Payment[]
  events     OrderStatusEvent[]
  redemption CouponRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String?
  name           String
  sku            String
  slug           String
  imageUrl       String?
  conditionGrade ConditionGrade
  warrantyMonths Int
  unitPrice      Int
  mrp            Int
  quantity       Int
  total          Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  userId    String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("razorpay")
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String?
  errorCode         String?
  errorDescription  String?
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Processed webhook ids, so a retried delivery is never applied twice.
model WebhookEvent {
  id         String   @id
  provider   String
  event      String
  receivedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Promotions
// ─────────────────────────────────────────────────────────────

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  description   String?
  type          CouponType
  /// Percentage (1–100) for PERCENTAGE, paise for FIXED.
  value         Int
  minOrderValue Int        @default(0)
  maxDiscount   Int?
  startsAt      DateTime?
  expiresAt     DateTime?
  usageLimit    Int?
  perUserLimit  Int?
  usedCount     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  /// When both lists are empty the coupon applies to the whole cart.
  products    Product[]          @relation("CouponProducts")
  categories  Category[]         @relation("CouponCategories")
  orders      Order[]
  redemptions CouponRedemption[]

  @@index([isActive, expiresAt])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  userId    String?
  email     String
  amount    Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId, email])
  @@index([couponId, userId])
}

// ─────────────────────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────────────────────

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String?
  authorName         String
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Store configuration (commerce settings — marketing copy lives in Keystatic)
// ─────────────────────────────────────────────────────────────

model StoreSettings {
  id                    String   @id @default("default")
  currency              String   @default("INR")
  /// GST rate in basis points (1800 = 18%).
  taxRateBps            Int      @default(1800)
  pricesIncludeTax      Boolean  @default(true)
  freeShippingThreshold Int      @default(0)
  flatShippingFee       Int      @default(0)
  expressShippingFee    Int      @default(49900)
  expressEnabled        Boolean  @default(true)
  codEnabled            Boolean  @default(true)
  codFee                Int      @default(0)
  codMaxOrderValue      Int?
  razorpayEnabled       Boolean  @default(true)
  lowStockThreshold     Int      @default(3)
  updatedAt             DateTime @updatedAt
}

/// Location-based shipping. A zone matches when the state or pincode prefix matches.
model ShippingZone {
  id              String   @id @default(cuid())
  name            String
  states          String[]
  pincodePrefixes String[]
  fee             Int      @default(0)
  expressFee      Int?
  minDays         Int      @default(3)
  maxDays         Int      @default(6)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Inbox (contact form, trade-in requests, newsletter)
// ─────────────────────────────────────────────────────────────

model ContactMessage {
  id        String      @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    InboxStatus @default(NEW)
  createdAt DateTime    @default(now())

  @@index([status, createdAt])
}

model TradeInRequest {
  id          String      @id @default(cuid())
  name        String
  email       String
  phone       String
  city        String
  brand       String
  model       String
  processor   String?
  ramGb       Int?
  storageGb   Int?
  ageYears    Int?
  condition   String
  notes       String?
  status      InboxStatus @default(NEW)
  createdAt   DateTime    @default(now())

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
