{
  "name": "renewbyte",
  "version": "0.1.0",
  "private": true,
  "description": "RenewByte — premium certified refurbished laptop store (Next.js, Prisma, Keystatic).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "images:generate": "node scripts/generate-images.mjs",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@markdoc/markdoc": "^0.5.10",
    "react-hook-form": "^7.88.0",
    "@hookform/resolvers": "^5.9.1",
    "zod": "^4.6.5",
    "framer-motion": "^13.4.2",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "geist": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "^5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^22",
    "@types/pg": "^8",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "tsx": "^4",
    "dotenv": "^17"
  }
}
